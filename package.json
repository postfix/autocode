{
  "name": "autocode-skill",
  "version": "0.1.1",
  "description": "JavaScript workflow skill for Codex and Claude agents",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/postfix/autocode.git"
  },
  "type": "module",
  "bin": {
    "autocode": "scripts/autocode.mjs"
  },
  "files": [
    "SKILL.md",
    "LICENSE",
    "README.md",
    "INSTALL.md",
    "USAGE.md",
    "agents/openai.yaml",
    "references/authoring.md",
    "references/quality-patterns.md",
    "assets/templates/*.js",
    "scripts/autocode.mjs",
    "scripts/claude-adapter.mjs",
    "scripts/codex-adapter.mjs",
    "scripts/runtime.mjs"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "coverage": "node --test --experimental-test-coverage tests/*.test.mjs"
  },
  "devDependencies": {
    "fast-check": "4.8.0"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.310",
    "@openai/codex-sdk": "0.164.0"
  }
}
