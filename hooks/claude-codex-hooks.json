{
  "hooks": {
    "SessionStart": [{
      "matcher": "startup|resume|clear|compact|fork",
      "hooks": [{
        "type": "command",
        "command": "node -e \"require(require('path').join(process.env.CLAUDE_PLUGIN_ROOT, 'hooks/autocode-mode.cjs')).run('SessionStart')\"",
        "timeout": 15
      }]
    }],
    "UserPromptSubmit": [{
      "hooks": [{
        "type": "command",
        "command": "node -e \"require(require('path').join(process.env.CLAUDE_PLUGIN_ROOT, 'hooks/autocode-mode.cjs')).run('UserPromptSubmit')\"",
        "timeout": 15
      }]
    }]
  }
}
